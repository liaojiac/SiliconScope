<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- WPF 内置转换器：bool → Visibility（页面切换用） -->
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>

  <!-- ==================== 深色主题==================== -->
  <!-- 与硬件监控工具一致，长时间烤机不刺眼；强调色 AMD 橙红 -->

  <Color x:Key="BgColor">#0B0E14</Color>
  <Color x:Key="PanelColor">#111721</Color>
  <Color x:Key="CardColor">#171E29</Color>
  <Color x:Key="Card2Color">#1C242F</Color>
  <Color x:Key="BorderColor">#2A3441</Color>
  <Color x:Key="Border2Color">#384656</Color>
  <Color x:Key="TextColor">#E6EDF3</Color>
  <Color x:Key="MutedColor">#8B949E</Color>
  <Color x:Key="DimColor">#6E7681</Color>
  <Color x:Key="AccentColor">#FF6B35</Color>
  <Color x:Key="Accent2Color">#FFB020</Color>
  <Color x:Key="OkColor">#3FB950</Color>
  <Color x:Key="WarnColor">#D29922</Color>
  <Color x:Key="ErrColor">#F85149</Color>
  <Color x:Key="InfoColor">#58A6FF</Color>
  <Color x:Key="PurpleColor">#BC8CFF</Color>

  <SolidColorBrush x:Key="BgBrush"       Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="PanelBrush"    Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="CardBrush"     Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="Card2Brush"    Color="{StaticResource Card2Color}"/>
  <SolidColorBrush x:Key="BorderBrush"   Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="Border2Brush"  Color="{StaticResource Border2Color}"/>
  <SolidColorBrush x:Key="TextBrush"     Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedBrush"    Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="DimBrush"      Color="{StaticResource DimColor}"/>
  <SolidColorBrush x:Key="AccentBrush"   Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="Accent2Brush"  Color="{StaticResource Accent2Color}"/>
  <SolidColorBrush x:Key="OkBrush"       Color="{StaticResource OkColor}"/>
  <SolidColorBrush x:Key="WarnBrush"     Color="{StaticResource WarnColor}"/>
  <SolidColorBrush x:Key="ErrBrush"      Color="{StaticResource ErrColor}"/>
  <SolidColorBrush x:Key="InfoBrush"     Color="{StaticResource InfoColor}"/>
  <SolidColorBrush x:Key="PurpleBrush"   Color="{StaticResource PurpleColor}"/>

  <!-- 基础文本 -->
  <Style TargetType="TextBlock" x:Key="Base">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="Muted" BasedOn="{StaticResource Base}">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="CardTitle">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- 卡片 -->
  <Style TargetType="Border" x:Key="Card">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Margin" Value="0,0,0,16"/>
  </Style>

  <!-- 主按钮 -->
  <Style TargetType="Button" x:Key="Primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="22,10"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#FF7F4D"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 次按钮 -->
  <Style TargetType="Button" x:Key="Ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border2Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="6"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#14FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 导航项 -->
  <Style TargetType="ListBoxItem" x:Key="NavItem">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Padding" Value="20,11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#1AFF6B35"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 开关 -->
  <Style TargetType="CheckBox" x:Key="Switch">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="42" Height="23">
            <Border x:Name="Track" Background="{StaticResource Card2Brush}" CornerRadius="12"
                    BorderBrush="{StaticResource Border2Brush}" BorderThickness="1"/>
            <Ellipse x:Name="Knob" Width="17" Height="17" Fill="{StaticResource MutedBrush}"
                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Knob" Property="Fill" Value="White"/>
              <Setter TargetName="Knob" Property="Margin" Value="22,0,0,0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 数据格 -->
  <Style TargetType="Border" x:Key="Stat">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

  <!-- 提示条 -->
  <Style TargetType="Border" x:Key="Note">
    <Setter Property="Background" Value="#1258A6FF"/>
    <Setter Property="BorderThickness" Value="3,0,0,0"/>
    <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
    <Setter Property="CornerRadius" Value="0,6,6,0"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="0,12,0,0"/>
  </Style>
  <Style TargetType="Border" x:Key="NoteWarn" BasedOn="{StaticResource Note}">
    <Setter Property="Background" Value="#12D29922"/>
    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
  </Style>
  <Style TargetType="Border" x:Key="Hint">
    <Setter Property="Background" Value="#12D29922"/>
    <Setter Property="BorderBrush" Value="#4DD29922"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

</ResourceDictionary>
