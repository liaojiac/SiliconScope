<UserControl x:Class="SiliconScope.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.Foreground="{StaticResource TextBrush}">
  <StackPanel>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <Grid Margin="0,0,0,6">
          <StackPanel>
            <TextBlock Text="本机历史成绩" Style="{StaticResource CardTitle}" FontSize="16"/>
            <TextBlock Text="{Binding History.Hint}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="刷新" Style="{StaticResource Ghost}" Command="{Binding History.RefreshCmd}"/>
            <Button Content="打开历史文件夹" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                    Command="{Binding History.OpenFolderCmd}"/>
          </StackPanel>
        </Grid>

        <!-- 空状态 -->
        <Border Style="{StaticResource Note}" Margin="0,8,0,0"
                Visibility="{Binding History.IsEmpty, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="还没有历史成绩。完成一次满载评测后会自动保存到这里。"
                     Style="{StaticResource Muted}" TextWrapping="Wrap"/>
        </Border>

        <!-- 历史列表 -->
        <ListBox ItemsSource="{Binding History.Items}"
                 SelectedItem="{Binding History.Selected, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                 MouseDoubleClick="ListBox_MouseDoubleClick"
                 Visibility="{Binding History.HasItems, Converter={StaticResource BoolToVis}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2258A6FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1658A6FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E6EDF3"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2258A6FF"/>
          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Margin" Value="0,0,0,8"/>
              <Setter Property="Padding" Value="0"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="14,10"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- SP 大数字 -->
                  <StackPanel Grid.Column="0" Width="74" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding SpText}" FontSize="26" FontWeight="Bold"
                                 Foreground="{Binding GradeColor}"/>
                      <TextBlock Text=" SP" FontSize="12" Foreground="{StaticResource DimBrush}"
                                 VerticalAlignment="Bottom" Margin="3,0,0,4"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- 型号 / 工作点 -->
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Model}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{StaticResource DimBrush}"
                               Margin="0,3,0,0"/>
                  </StackPanel>

                  <!-- 评级 / 时间 -->
                  <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Grade}" FontSize="15" FontWeight="Bold"
                               Foreground="{Binding GradeColor}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TimeText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                    Visibility="{Binding History.HasItems, Converter={StaticResource BoolToVis}}">
          <Button Content="查看详情" Style="{StaticResource Primary}" Command="{Binding History.OpenCmd}"/>
          <Button Content="删除选中" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                  Command="{Binding History.DeleteCmd}"/>
        </StackPanel>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
