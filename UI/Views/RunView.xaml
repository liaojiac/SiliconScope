<UserControl x:Class="SiliconScope.UI.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SiliconScope.UI.Controls"
             TextElement.Foreground="{StaticResource TextBrush}">
  <StackPanel>

    <!-- ===== 步骤条 ===== -->
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Ellipse Width="24" Height="24" Fill="{StaticResource AccentBrush}"/>
        <TextBlock Text="1  环境自检" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="{StaticResource TextBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Ellipse Width="24" Height="24">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource Card2Brush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Run.Step}" Value="1">
                  <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Run.Step}" Value="2">
                  <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Run.Step}" Value="3">
                  <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="2  满载负载" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Ellipse Width="24" Height="24">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource Card2Brush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Run.Step}" Value="2">
                  <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Run.Step}" Value="3">
                  <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="3  多点采样" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Ellipse Width="24" Height="24">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource Card2Brush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Run.Step}" Value="3">
                  <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="4  评分" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
    </Grid>

    <!-- ===== 步骤 0：环境自检 ===== -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{Binding Run.TipTitle}" Style="{StaticResource CardTitle}" FontSize="16"/>
        <TextBlock Text="{Binding Run.TipDesc}" Style="{StaticResource Muted}" Margin="0,6,0,14"/>

        <!-- 检查清单 -->
        <ItemsControl ItemsSource="{Binding Run.EnvItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="9,0" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Icon}" Foreground="{Binding Color}"
                             FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                             Foreground="{StaticResource TextBrush}" FontSize="13"/>
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="▶  开始评测" Style="{StaticResource Primary}"
                  Command="{Binding Run.StartCmd}"/>
          <Button Content="重新检测" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                  Command="{Binding Run.StartCmd}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ===== 步骤 1：等待满载 ===== -->
    <Border>
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Run.Step}" Value="1">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <TextBlock Text="等待满载负载" Style="{StaticResource CardTitle}" FontSize="16"/>
        <TextBlock Text="评分必须在满载稳态下采集，否则工作点不具可比性。"
                   Style="{StaticResource Muted}" Margin="0,6,0,14"/>

        <Border Style="{StaticResource Hint}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#F0D9A0">
              <Run FontWeight="Bold">请现在运行任意烤机工具</Run>
              <Run>（任选其一），等待约 1 分钟让频率与温度稳定：</Run>
            </TextBlock>
            <TextBlock Text="OCCT  ·  Prime95  ·  Y-Cruncher  ·  AIDA64" FontSize="12"
                       Foreground="{StaticResource Accent2Brush}" Margin="0,6,0,4"
                       FontFamily="Consolas"/>
            <TextBlock Text="{Binding Run.FullLoadTargetText}" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Border>

        <!-- 实时读数 -->
        <UniformGrid Columns="4" Margin="0,0,0,14">
          <Border Style="{StaticResource Stat}" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="当前频率" Style="{StaticResource Muted}" FontSize="11"/>
              <TextBlock FontSize="20" FontWeight="Bold">
                <Run Text="{Binding Run.LiveFreq, Mode=OneWay, StringFormat={}{0:F0}}"/>
                <Run Text=" MHz" FontSize="11" Foreground="{StaticResource DimBrush}"/>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Stat}" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="核心电压" Style="{StaticResource Muted}" FontSize="11"/>
              <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource OkBrush}">
                <Run Text="{Binding Run.LiveVolt, Mode=OneWay, StringFormat={}{0:F3}}"/>
                <Run Text=" V" FontSize="11" Foreground="{StaticResource DimBrush}"/>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Stat}" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="温度" Style="{StaticResource Muted}" FontSize="11"/>
              <TextBlock FontSize="20" FontWeight="Bold">
                <Run Text="{Binding Run.LiveTemp, Mode=OneWay, StringFormat={}{0:F0}}"/>
                <Run Text=" ℃" FontSize="11" Foreground="{StaticResource DimBrush}"/>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Stat}">
            <StackPanel>
              <TextBlock Text="满载状态" Style="{StaticResource Muted}" FontSize="11"/>
              <TextBlock FontSize="16" FontWeight="Bold" Margin="0,3,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="未达满载"/>
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Run.FullLoadReached}" Value="True">
                        <Setter Property="Text" Value="已满载"/>
                        <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- 持续满载稳定确认满 1 分钟且占比达标才自动采样，排除偶发冲高/刚满载） -->
        <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="14,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="持续满载稳定确认" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="{Binding Run.StableSecondsText, Mode=OneWay}" FontSize="12.5"
                         HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"
                         FontFamily="Consolas"/>
            </Grid>
            <ProgressBar Height="7" Minimum="0"
                         Maximum="{Binding Run.StableTarget, Mode=OneWay}"
                         Value="{Binding Run.StableSeconds, Mode=OneWay}"
                         Background="{StaticResource BgBrush}"
                         Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
            <TextBlock Text="{Binding Run.StableText, Mode=OneWay}" Style="{StaticResource Muted}"
                       FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal">
          <Button Content="立即采样（需稳定满 1 分钟）" Style="{StaticResource Primary}"
                  Command="{Binding Run.StartSampleCmd}"/>
          <TextBlock Text="持续满载达标后会自动开始，通常无需手动点击；中途掉载会回退计时。"
                     Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"
                     TextWrapping="Wrap" MaxWidth="430"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ===== 步骤 2：多点采样（实时 V/F 图）===== -->
    <Border>
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Run.Step}" Value="2">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <TextBlock Text="多点采样中" Style="{StaticResource CardTitle}" FontSize="16"/>
        <TextBlock Text="约 10 秒稳态连续采集多个 (频率, 电压) 工作点，用于拟合这颗 CPU 的 V/F 曲线，期间请保持烤机满载。"
                   Style="{StaticResource Muted}" Margin="0,6,0,14"/>

        <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="200"
                Margin="0,12,0,10">
          <ctl:VfChart Points="{Binding Run.LivePoints}"
                       AnchorFreq="{Binding Result.AnchorFreq}"
                       Slope="{Binding Result.Slope}"/>
        </Border>

        <ProgressBar Height="6" Minimum="0" Maximum="{Binding Run.Total, Mode=OneWay}"
                     Value="{Binding Run.Done, Mode=OneWay}" Background="{StaticResource Card2Brush}"
                     Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
        <TextBlock Text="{Binding Run.ProgressText}" Style="{StaticResource Muted}"
                   Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <!-- ===== 步骤 3：完成 ===== -->
    <Border>
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Run.Step}" Value="3">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="✓ 评测完成" Style="{StaticResource CardTitle}" FontSize="18"
                   HorizontalAlignment="Center" Foreground="{StaticResource OkBrush}"/>
        <TextBlock Text="{Binding Run.TipDesc}" Style="{StaticResource Muted}"
                   HorizontalAlignment="Center" Margin="0,8,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="↻  重新评测" Style="{StaticResource Primary}"
                  Command="{Binding Run.RestartCmd}"/>
          <Button Content="查看评分详情" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                  Command="{Binding Run.ViewResultCmd}"/>
        </StackPanel>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
