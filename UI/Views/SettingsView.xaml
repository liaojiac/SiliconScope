<UserControl x:Class="SiliconScope.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.Foreground="{StaticResource TextBrush}">
  <StackPanel>

    <!-- 数据源 -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="数据源" Style="{StaticResource CardTitle}"/>

        <Border Padding="0,12" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="HWiNFO 增强采集（每核 VID）" FontSize="13.5"/>
              <TextBlock Text="默认开启并自动探测。需运行 HWiNFO，并在“右键托盘 HWiNFO 图标→设置(Settings)→通用/用户界面(General/User Interface) 右列”勾选“共享内存支持(Shared Memory Support)”（HWiNFO v7 起默认关闭，勾选后需重启 HWiNFO；免费版每 12 小时需重启一次）。未开启时自动回退 LHM，不影响主分。"
                         Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="640"/>
            </StackPanel>
            <CheckBox HorizontalAlignment="Right" Style="{StaticResource Switch}"
                      IsChecked="{Binding Setting.EnableHwinfo}"/>
          </Grid>
        </Border>

        <Border Padding="0,12" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="传感器探测模式" FontSize="13.5"/>
              <TextBlock Text="首次运行自动探测并缓存映射；不同主板的传感器命名差异会自动适配" Style="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <ComboBox HorizontalAlignment="Right" Width="190" SelectedValue="{Binding Setting.ProbeMode}"
                      SelectedValuePath="Tag">
              <ComboBoxItem Content="AutoOnFirstRun（推荐）" Tag="AutoOnFirstRun"/>
              <ComboBoxItem Content="AlwaysAuto（调试）" Tag="AlwaysAuto"/>
              <ComboBoxItem Content="OffUntilError" Tag="OffUntilError"/>
            </ComboBox>
          </Grid>
        </Border>

        <Border Padding="0,12" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="稳态采样（约 10 秒）" FontSize="13.5"/>
              <TextBlock Text="500ms × 20 轮 ≈ 10 秒稳态窗口，消除 P-State 瞬时值、让稳态电压更可信" Style="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <CheckBox HorizontalAlignment="Right" Style="{StaticResource Switch}"
                      IsChecked="{Binding Setting.MultiSample}"/>
          </Grid>
        </Border>

        <Border Padding="0,12">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="满载判定阈值" FontSize="13.5"/>
              <TextBlock Text="频率 ≥ MaxBoost × 该值才允许评分；过低会误判重负载为未满载" Style="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <ComboBox HorizontalAlignment="Right" Width="190" SelectedValue="{Binding Setting.FullLoadThresholdText}"
                      SelectedValuePath="Tag">
              <ComboBoxItem Content="0.90（推荐）" Tag="0.90"/>
              <ComboBoxItem Content="0.85（宽松）" Tag="0.85"/>
              <ComboBoxItem Content="0.95（严格）" Tag="0.95"/>
            </ComboBox>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- 评分与量表 -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="评分与量表" Style="{StaticResource CardTitle}"/>

        <Border Padding="0,12" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="基准量表" FontSize="13.5"/>
              <TextBlock Text="baseline.json · 支持热更新，新增型号无需重编译" Style="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="{StaticResource Card2Brush}"
                    CornerRadius="6" Padding="10,5">
              <TextBlock Text="baseline.json" FontSize="11.5" FontFamily="Consolas"
                         Foreground="{StaticResource MutedBrush}"/>
            </Border>
          </Grid>
        </Border>

        <Border Padding="0,12" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="自标定 V/F 拟合" FontSize="13.5"/>
              <TextBlock Text="采集到 ≥3 个工作点时，用本机拟合斜率替代代际默认值" Style="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <CheckBox HorizontalAlignment="Right" Style="{StaticResource Switch}"
                      IsChecked="{Binding Setting.SelfFit}"/>
          </Grid>
        </Border>

        <Border Padding="0,12">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="云端分位表" FontSize="13.5"/>
              <TextBlock Text="后续版本提供相对百分位；当前仅离线绝对分" Style="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#123FB950" CornerRadius="6" Padding="10,5">
              <TextBlock Text="接口预留" FontSize="11.5" Foreground="{StaticResource OkBrush}"/>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- 日志与隐私 -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="日志与隐私" Style="{StaticResource CardTitle}"/>

        <Border Padding="0,12" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="日志级别" FontSize="13.5"/>
              <TextBlock Text="写入程序同级 logs/ 目录，按天切分" Style="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="打开日志目录" Style="{StaticResource Ghost}"
                      Command="{Binding Setting.OpenLogCmd}"/>
              <ComboBox Width="130" Margin="8,0,0,0" SelectedValue="{Binding Setting.LogLevel}"
                        SelectedValuePath="Content">
                <ComboBoxItem Content="Verbose"/>
                <ComboBoxItem Content="Info"/>
                <ComboBoxItem Content="Warn"/>
                <ComboBoxItem Content="Error"/>
              </ComboBox>
            </StackPanel>
          </Grid>
        </Border>

        <Border Padding="0,12" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="诊断报告保留" FontSize="13.5"/>
              <TextBlock Text="自动保留最近若干份，防止磁盘膨胀" Style="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="打开报告目录" Style="{StaticResource Ghost}"
                      Command="{Binding Setting.OpenReportCmd}"/>
              <ComboBox Width="90" Margin="8,0,0,0" SelectedValue="{Binding Setting.RetainReportsText}"
                        SelectedValuePath="Tag">
                <ComboBoxItem Content="5 份" Tag="5"/>
                <ComboBoxItem Content="10 份" Tag="10"/>
                <ComboBoxItem Content="20 份" Tag="20"/>
              </ComboBox>
            </StackPanel>
          </Grid>
        </Border>

        <Border Padding="0,12">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="数据上传" FontSize="13.5"/>
              <TextBlock Text="当前版本完全不上传任何数据；无账号，仅本地设备 ID 标识"
                         Style="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#123FB950" CornerRadius="6" Padding="10,5">
              <TextBlock Text="本地闭环" FontSize="11.5" Foreground="{StaticResource OkBrush}"/>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- 关于 -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="关于" Style="{StaticResource CardTitle}"/>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12.5">
          本软件为可复现、可校验的自研 CPU 体质评分，基于满载稳态工作点与 V/F 折算，
          不依赖、也不对标任何厂商的闭源内置分数。
          LHM 采用 MPL-2.0 开源许可，可免费商用闭源分发。
        </TextBlock>
        <Border Style="{StaticResource Note}" Margin="0,12,0,0">
          <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11.5">
            评级分五档：大雕 ≥112 · 小雕 ≥104 · 普通 ≥96 · 小雷 ≥88 · 大雷 &lt;88（SP 分制，以 100 为中心每档 8 分对称）。
          </TextBlock>
        </Border>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
