<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SiliconScope.UI</RootNamespace>
    <!-- 程序集名/产物名一律用纯 ASCII。
         中文程序集名会让 apphost/hostfxr 在非 UTF-8 区域（如简体中文 Win10，代码页 936）
         定位入口程序集失败，表现为双击 exe 静默退出、无日志无弹窗。窗口标题仍显示中文。 -->
    <AssemblyName>SiliconScope</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <!-- ★ 仅 Windows：WPF 依赖 net8.0-windows，Win10/11 均支持 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 复用已有的纯 C# 类库：UI 只做调用与展示，不再往核心塞界面逻辑 -->
    <ProjectReference Include="..\采集层\src\Collector\Collector.csproj" />
    <ProjectReference Include="..\评分引擎\src\ScoringEngine\ScoringEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- baseline.json 需复制到输出目录（与采集层一致） -->
    <None Include="..\采集层\src\Collector\baseline.json" Link="baseline.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 启动失败时用于抓取宿主层错误的诊断脚本 -->
    <None Include="诊断启动.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
