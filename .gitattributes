# 统一跨平台行尾，避免 Windows 批处理因 LF 失效、源码因 CRLF 产生噪声 diff
* text=auto

# 源码与文本：统一 LF
*.cs   text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln  text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Windows 脚本：必须 CRLF（诊断启动.bat 在个别环境 LF 下异常）
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制（占位，后续若加图标/图片按此处理）
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.zip  binary
